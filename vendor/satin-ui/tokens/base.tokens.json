            "var": "--pad-card",
            "source": "kit.css"
          }
        },
        "$description": "卡片内边距"
      },
      "panel": {
        "$type": "dimension",
        "$value": "{space.24}",
        "$extensions": {
          "com.satin": {
            "var": "--pad-panel",
            "source": "kit.css"
