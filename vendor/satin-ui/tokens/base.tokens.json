      "$value": "64px",
      "$extensions": {
        "com.satin": {
          "var": "--sp-64",
          "source": "kit.css"
        }
      },
      "$description": "间距 64px（刻度：4 的倍数为主）"
    },
    "80": {
      "$type": "dimension",
      "$value": "80px",
      "$extensions": {
        "com.satin": {
          "var": "--sp-80",
          "source": "kit.css"
        }
      },
      "$description": "间距 80px（刻度：4 的倍数为主）"
    },
    "gap": {
      "tight": {
        "$type": "dimension",
        "$value": "{space.4}",
        "$extensions": {
          "com.satin": {
            "var": "--gap-tight",
            "source": "kit.css"
          }
        },
        "$description": "最紧的间距：图标和文字"
      },
      "inline": {
        "$type": "dimension",
        "$value": "{space.8}",
        "$extensions": {
          "com.satin": {
            "var": "--gap-inline",
            "source": "kit.css"
          }
        },
        "$description": "同一行元素之间"
      },
      "stack": {
        "$type": "dimension",
        "$value": "{space.12}",
        "$extensions": {
          "com.satin": {
            "var": "--gap-stack",
            "source": "kit.css"
          }
        },
        "$description": "上下相邻的小块之间"
      },
      "group": {
        "$type": "dimension",
        "$value": "{space.16}",
        "$extensions": {
          "com.satin": {
            "var": "--gap-group",
            "source": "kit.css"
          }
        },
        "$description": "一组和一组之间"
      },
      "section": {
