    "framer-motion": "^12.34.3",
    "i18next": "^25.7.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "^16.4.0",
    "react-router-dom": "7.18.1",
    "satin-ui": "workspace:*",
